# 智慧树账号配置
ZHIHUISHU_USERNAME=YOURNAME
ZHIHUISHU_PASSWORD=YOURPASSWORD
COURSE_NAME="你要学习的课程名称"

# API配置（DashScope OpenAI兼容 API）
DASHSCOPE_API_KEY="你的API密钥"
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 答题模型配置
ENABLE_LLM_ANSWER=true   # 是否使用大模型自动答题（true/false）
ANSWER_MODEL="qwen3.6-plus"  # 用于答题的模型

# 可选配置
ENABLE_REASONING=false    # 是否启用推理模式
